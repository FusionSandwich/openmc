+                      && helical_summary.distance_mismatches == 0
+                      && torus_summary.fallback_failures == 0
+                      && helical_summary.fallback_failures == 0;
 
   std::cout << std::setprecision(17)
             << "{\n  \"schema_version\": 1,\n"
