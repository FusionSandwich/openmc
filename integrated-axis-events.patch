+            fixtures.fixture('corruption-oracle', 0, 1 + 2**-48)[1], 0,
+            {'p': [.25, .42, .27], 'd': [1., 0., 0.], 'steps': 5})
+        rejected = []
+        for corruption in ['owner', 'missing_gap', 'redistributed_flux', 'wrong_current', 'missing_contact']:
+            bad = copy.deepcopy(row)
+            if corruption == 'owner': bad['events'][0]['after'] = 108
+            elif corruption == 'missing_gap': bad['events'].pop(1)
+            elif corruption == 'redistributed_flux':
+                amount = bad['events'][1]['scores'][0][0]
+                assert amount > 0
+                bad['events'][1]['scores'][0][1] += amount
+                bad['events'][1]['scores'][0][0] = 0.
+            elif corruption == 'wrong_current': bad['events'][0]['scores'][1] = [0.] * len(bad['scores'][1])
+            else: bad['events'][0]['contacts'] = []
+            try:
+                fixtures.check(bad, wanted)
+            except AssertionError:
+                rejected.append(corruption)
+        assert len(rejected) == 5
+        retained()
+        assert sha(options.cross_sections) == xs_identity
+        assert all(sha(native_source / p) == h and sha(ROOT / p) == h for p, h in identities.items())
+        total_bytes = size(NATIVE) + size(OUT) + (size(REUSED_ROOT) if REUSED_ROOT else 0)
+        assert total_bytes < CAP
+        save('receipt.json', {'status': 'PASS_PENDING_INDEPENDENT_REVIEW',
+             'seconds': time.monotonic() - started, 'models': len(results),
+             'rows': sum(len(x['rows']) for x in results), 'corruptions_rejected': rejected,
+             'legacy_models': len(legacy), 'native_outputs': str(NATIVE),
+             'output_bytes': total_bytes, 'lease': 'release after terminal children'})
+    except BaseException as error:
+        save('failure.json', {'status': 'FIRST_FAILURE_NO_RETRY', 'error': repr(error),
+             'seconds': time.monotonic() - started, 'native_outputs': str(NATIVE)})
+        raise
+    finally:
+        if json.loads(owner_file.read_text())['owner'] == token:
+            owner_file.unlink()
+            LOCK.rmdir()
+
+
+if __name__ == '__main__':
+    main()
diff --git a/dev/stellarcsg/tests/test_dyadic_axis_plane.cpp b/dev/stellarcsg/tests/test_dyadic_axis_plane.cpp
new file mode 100644
index 000000000..8a89e598d
--- /dev/null
+++ b/dev/stellarcsg/tests/test_dyadic_axis_plane.cpp
@@ -0,0 +1,177 @@
+#include "stellarcsg/dyadic_axis_plane.hpp"
+
+#include <cfenv>
+#include <cmath>
+#include <cstring>
+#include <iomanip>
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+#include <string>
+
+using namespace stellarcsg;
+
+namespace {
+void require(bool condition, const char* reason)
+{
+  if (!condition) throw std::runtime_error(reason);
+}
+
+double from_bits(std::uint64_t bits)
+{
+  double value;
+  std::memcpy(&value, &bits, sizeof(value));
+  return value;
+}
+
+std::uint64_t bits(double value)
+{
+  std::uint64_t out;
+  std::memcpy(&out, &value, sizeof(out));
+  return out;
+}
+
+template<class F> void rejects(F operation)
+{
+  bool caught = false;
+  try {
+    operation();
+  } catch (const std::invalid_argument&) {
+    caught = true;
+  }
+  require(caught, "Invalid argument was accepted");
+}
+
+void controls()
+{
+  const double gap = std::ldexp(1.0, -48);
+  const double next = std::nextafter(1.0, 2.0);
+  UnitAxisRay reverse {{1.75 + gap, .31, .42}, 0, -1};
+  auto b = axis_plane_contact(reverse, {0, 1.0 + gap});
+  auto a = axis_plane_contact(reverse, {0, 1.0});
+  require(b.status == AxisContactStatus::future, "B future contact missing");
+  require(b.parameter.compare(a.parameter) < 0, "Positive gap became a tie");
+  require(b.parameter.rounded().value == .75, "Wrong B exit parameter");
+  require(a.parameter.rounded().value == .75 + gap, "Wrong A entry parameter");
+  require(axis_plane_limit_side(reverse, 1.0 + gap, {0, 1.0}, true) == 1,
+    "Nearby A was classified inside at B exit");
+  require(axis_plane_limit_side(reverse, 1.0 + gap, {0, 1.0 + gap}, true) == -1,
+    "B outgoing limit wrong");
+  auto length = axis_interval_length(reverse, 1.0 + gap, 1.0);
+  require(length.sign() == 1 && length.rounded().exact
+      && length.rounded().value == gap, "Local gap length lost");
+  require(axis_interval_length(reverse, 1.0, 1.0 + gap).sign() == -1,
+    "Reversed progress was accepted");
+  require(axis_interval_length(reverse, 1.0, 1.0).sign() == 0, "True tie nonzero");
+  UnitAxisRay adjacent {{1.75, .31, .42}, 0, -1};
+  auto left = axis_plane_contact(adjacent, {0, 1.0});
+  auto right = axis_plane_contact(adjacent, {0, next});
+  require(right.parameter.compare(left.parameter) < 0,
+    "Adjacent-double contacts merged");
+  require(std::nextafter(1.0, next) == next, "Adjacent fixture has an interior double");
+  require(axis_interval_length(adjacent, next, 1.0).rounded().value
+      == std::ldexp(1.0, -52), "No-interior-point interval lost");
+  UnitAxisRay large {{-1e20, .31, .42}, 0, 1};
+  left = axis_plane_contact(large, {0, 1.0});
+  right = axis_plane_contact(large, {0, next});
+  require(bits(left.parameter.rounded().value) == bits(right.parameter.rounded().value),
+    "Rounded-equal absolute parameter fixture invalid");
+  require(left.parameter.compare(right.parameter) < 0,
+    "Rounded-equal absolute parameters treated as an exact tie");
+  require(axis_interval_length(large, 1.0, next).rounded().value
+      == std::ldexp(1.0, -52), "Rounded absolute subtraction lost delta");
+  for (int axis = 0; axis < 3; ++axis) {
+    for (int direction : {-1, 1}) {
+      UnitAxisRay ray {{0., 0., 0.}, axis, direction};
+      auto origin = axis_plane_contact(ray, {axis, -0.});
+      require(origin.status == AxisContactStatus::origin, "Signed zero origin wrong");
+      require(axis_plane_limit_side(ray, 0., {axis, 0.}, true) == direction,
+        "Outgoing tied side wrong");
+      require(axis_plane_limit_side(ray, 0., {axis, 0.}, false) == -direction,
+        "Incoming tied side wrong");
+      const int parallel_axis = (axis + 1) % 3;
+      require(axis_plane_contact(ray, {parallel_axis, 0.}).status
+          == AxisContactStatus::coplanar, "Coplanar contact resolved as a point");
+      require(axis_plane_limit_side(ray, 0., {parallel_axis, 0.}, true) == 0,
+        "Coplanar side resolved by direction");
+      require(axis_plane_contact(ray, {parallel_axis, 1.}).status
+          == AxisContactStatus::miss, "Parallel miss wrong");
+      require(axis_plane_contact(ray, {axis, -static_cast<double>(direction)}).status
+          == AxisContactStatus::behind, "Negative parameter clipped to origin");
+    }
+  }
+  const auto subnormal = std::numeric_limits<double>::denorm_min();
+  auto small = DyadicDifference::between(subnormal, 0.0);
+  require(small.sign() == 1 && bits(small.rounded().value) == 1,
+    "Minimum subnormal lost");
+  auto big = DyadicDifference::between(std::numeric_limits<double>::max(),
+    -std::numeric_limits<double>::max());
+  require(big.rounded().status == DyadicRoundingStatus::overflow
+      && !big.rounded().exact && big.sign() == 1, "Overflow converted to finite length");
+  require(DyadicDifference::between(-0., 0.).sign() == 0, "Signed zero difference wrong");
+  require(DyadicDifference::between(-4., -2.).compare(
+      DyadicDifference::between(-2., -1.)) < 0, "Negative parameter ordering wrong");
+  rejects([] { DyadicDifference::between(INFINITY, 0.); });
+  rejects([] { DyadicDifference::between(0., NAN); });
+  rejects([] { UnitAxisRay ray {{0., 0., 0.}, 3, 1}; });
+  rejects([] { UnitAxisRay ray {{0., 0., 0.}, 0, 0}; });
+  rejects([] { UnitAxisRay ray {{INFINITY, 0., 0.}, 0, 1}; });
+  rejects([&] { axis_plane_contact(reverse, {3, 1.}); });
+  rejects([&] { strict_axis_plane_side(reverse, NAN, {0, 1.}); });
+}
+
+void query_stream()
+{
+  std::string first, second;
+  while (std::cin >> first >> second) {
+    try {
+      auto value = DyadicDifference::between(from_bits(std::stoull(first, nullptr, 16)),
+        from_bits(std::stoull(second, nullptr, 16)));
+      auto rounded = value.rounded();
+      std::cout << std::dec << value.sign() << ' ';
+      bool started = false;
+      for (std::size_t i = value.magnitude().size(); i-- > 0;) {
+        const auto word = value.magnitude()[i];
+        if (!started && !word) continue;
+        if (started) std::cout << std::setw(16) << std::setfill('0');
+        std::cout << std::hex << word;
+        started = true;
+      }
+      if (!started) std::cout << '0';
+      std::cout << ' ' << std::hex << bits(rounded.value) << ' ' << std::dec
+                << (rounded.status == DyadicRoundingStatus::overflow) << ' '
+                << rounded.exact << '\n';
+    } catch (const std::invalid_argument&) {
+      std::cout << "INVALID\n";
+    }
+  }
+  if (!std::cin.eof()) throw std::runtime_error("Malformed query stream");
+}
+} // namespace
+
+int main(int argc, char** argv)
+{
+  try {
+    if (argc == 2 && std::string(argv[1]) == "--query") {
+      query_stream();
+    } else if (argc == 1) {
+      for (int mode : {FE_TONEAREST, FE_DOWNWARD, FE_UPWARD, FE_TOWARDZERO}) {
+        require(std::fesetround(mode) == 0, "Floating environment mode unavailable");
+        // Non-integer fixture construction belongs to the nearest mode;
+        // verify integer-backed rounding separately in all four modes.
+        const auto rounded = DyadicDifference::between(1., -std::ldexp(1., -53)).rounded();
+        require(bits(rounded.value) == bits(1.) && !rounded.exact,
+          "Nearest-even depends on caller floating rounding mode");
+      }
+      std::fesetround(FE_TONEAREST);
+      controls();
+      std::cout << "PASS dyadic axis-plane controls\n";
+    } else {
+      return 2;
+    }
+    return 0;
+  } catch (const std::exception& error) {
+    std::cerr << error.what() << '\n';
+    return 1;
+  }
+}
diff --git a/dev/stellarcsg/tests/test_native_axis_events.cpp b/dev/stellarcsg/tests/test_native_axis_events.cpp
new file mode 100644
index 000000000..4a62146fb
--- /dev/null
+++ b/dev/stellarcsg/tests/test_native_axis_events.cpp
@@ -0,0 +1,242 @@
+// Native deterministic events; external Fraction oracle checks every row/bin.
+#include <filesystem>
+#include <fstream>
+#include <iomanip>
+#include <iostream>
+#include <sstream>
+#ifdef __unix__
+#include <dlfcn.h>
+#endif
+#include "openmc/capi.h"
+#include "openmc/cell.h"
+#include "openmc/geometry.h"
+#include "openmc/particle.h"
+#include "openmc/settings.h"
+#include "openmc/surface.h"
+#include "openmc/tallies/tally.h"
+#include "pugixml.hpp"
+
+using namespace openmc;
+
+struct FixtureState {
+  vector<double> offsets;
+  vector<vector<int32_t>> materials;
+
+  static double offset(const Surface& s)
+  {
+    if (const auto* x = dynamic_cast<const SurfaceXPlane*>(&s)) return x->x0_;
+    if (const auto* y = dynamic_cast<const SurfaceYPlane*>(&s)) return y->y0_;
+    if (const auto* z = dynamic_cast<const SurfaceZPlane*>(&s)) return z->z0_;
+    return 0.;
+  }
+
+  FixtureState()
+  {
+    for (const auto& s : model::surfaces) offsets.push_back(offset(*s));
+    for (const auto& c : model::cells) materials.push_back(c->material_);
+  }
+
+  void restore() const
+  {
+    for (size_t i = 0; i < offsets.size(); ++i) {
+      auto& s = *model::surfaces[i];
+      if (auto* x = dynamic_cast<SurfaceXPlane*>(&s)) x->x0_ = offsets[i];
+      if (auto* y = dynamic_cast<SurfaceYPlane*>(&s)) y->y0_ = offsets[i];
+      if (auto* z = dynamic_cast<SurfaceZPlane*>(&s)) z->z0_ = offsets[i];
+    }
+    for (size_t i = 0; i < materials.size(); ++i)
+      model::cells[i]->material_ = materials[i];
+  }
+
+  bool matches() const
+  {
+    for (size_t i = 0; i < offsets.size(); ++i)
+      if (offset(*model::surfaces[i]) != offsets[i]) return false;
+    for (size_t i = 0; i < materials.size(); ++i)
+      if (model::cells[i]->material_ != materials[i]) return false;
+    return true;
+  }
+
+  ~FixtureState() { restore(); }
+};
+
+void bins()
+{
+  std::cout << ",\"scores\":[";
+  for (size_t t = 0; t < model::tallies.size(); ++t) {
+    if (t) std::cout << ',';
+    std::cout << '[';
+    for (int b = 0; b < model::tallies[t]->n_filter_bins(); ++b) {
+      if (b) std::cout << ',';
+      std::cout << model::tallies[t]->results_(b, 0, 0);
+    }
+    std::cout << ']';
+  }
+  std::cout << ']';
+}
+
+int main(int argc, char** argv)
+{
+  if (argc != 3) return 2;
+  const auto query_file = std::filesystem::absolute(argv[2]);
+  std::filesystem::current_path(argv[1]);
+  pugi::xml_document geometry;
+  if (!geometry.load_file("geometry.xml")) return 3;
+  char name[] = "native-axis-test";
+  char* args[] = {name};
+#ifdef __unix__
+  Dl_info loaded {};
+  if (!dladdr(reinterpret_cast<void*>(&openmc_init), &loaded)) return 7;
+  std::cout << "META {\"library\":" << std::quoted(loaded.dli_fname)
+    << ",\"geometry_state_bytes\":" << sizeof(GeometryState) << "}\n";
+#endif
+  for (int cycle = 0; cycle < 2; ++cycle) {
+    int code = openmc_init(1, args, nullptr);
+    if (code) return code;
+    code = openmc_simulation_init();
+    if (code) return code;
+    model::active_tracklength_tallies.clear();
+    model::active_surface_tallies.clear();
+    for (int i = 0; i < static_cast<int>(model::tallies.size()); ++i) {
+      auto& t = *model::tallies[i];
+      t.active_ = true;
+      if (t.type_ == TallyType::SURFACE) model::active_surface_tallies.push_back(i);
+      else model::active_tracklength_tallies.push_back(i);
+    }
+    {
+      std::ifstream input(query_file);
+      std::cout << std::setprecision(17);
+      std::string line;
+      Particle p; // Reuse the same object across sources, including failed queries.
+      const FixtureState baseline;
+      while (std::getline(input, line)) {
+        if (line.empty()) continue;
+        std::istringstream row(line);
+        int id, steps, mode, hint;
+        SourceSite source;
+        row >> id >> source.r.x >> source.r.y >> source.r.z >> source.u.x >> source.u.y
+            >> source.u.z >> hint >> steps >> mode;
+        if (!row) return 4;
+        source.surf_id = hint;
+        source.E = 1.e6;
+        for (auto& t : model::tallies) t->reset();
+        if (!baseline.matches()) return 8;
+        const FixtureState query_state;
+        bool source_reset = false;
+        std::cout << "ROW {\"id\":" << id << ",\"cycle\":" << cycle << ",\"events\":[";
+        bool first = true;
+        std::string error;
+        try {
+#ifdef OPENMC_EXPERIMENTAL_AXIS_PLANES
+          const auto previous_epoch = p.axis_plane_context().epoch;
+#endif
+          p.from_source(&source);
+#ifdef OPENMC_EXPERIMENTAL_AXIS_PLANES
+          const auto& reset = p.axis_plane_context();
+          source_reset = !reset.valid && !reset.pending && !reset.advanced &&
+            reset.contacts.empty() && reset.outgoing_sides.empty() &&
+            reset.epoch == previous_epoch + 1;
+          if (!source_reset) throw std::runtime_error("SOURCE_CONTEXT_NOT_RESET");
+#else
+          source_reset = true;
+#endif
+          p.id() = id;
+          if (!exhaustive_find_cell(p)) throw std::runtime_error("NO_START_OWNER");
+          if (mode == 3) model::cells[p.coord(0).cell()]->material_[0] = 0;
+          if (mode == 4) {
+#ifdef OPENMC_EXPERIMENTAL_AXIS_PLANES
+            p.axis_plane_context().reset();
+#endif
+            p.r()[0] = -1.7976931348623157e308;
+            // Keep a valid common enclosure and ordered slabs while making the
+            // first interval 1.5*DBL_MAX. Restore every offset even on exception.
+            const double maximum = 1.7976931348623157e308;
+            for (auto& s : model::surfaces) {
+              if (auto* x = dynamic_cast<SurfaceXPlane*>(s.get())) {
+                switch (s->id_) {
+                case 1: x->x0_ = -maximum; break;
+                case 2: x->x0_ = maximum; break;
+                case 10: x->x0_ = maximum/2; break;
+                case 11: x->x0_ = maximum*.75; break;
+                case 20: x->x0_ = maximum*.875; break;
+                case 21: x->x0_ = maximum; break;
+                case 30: x->x0_ = maximum*.25; break;
+                }
+              }
+            }
+            p.u() = {1., 0., 0.};
+            Region extreme("-10", 0);
+            (void) extreme.distance(p.r(), p.u(), SURFACE_NONE);
+            throw std::runtime_error("OVERFLOW_GUARD_DID_NOT_REJECT");
+          }
+#ifdef OPENMC_EXPERIMENTAL_AXIS_PLANES
+          if (mode == 1) p.u()[p.axis_plane_context().axis] *= -1.; // stale epoch
+#endif
+          if (mode == 2) p.event_collide(); // prohibited before any score
+          for (int step = 0; step < steps && p.wgt() > 0.; ++step) {
+            const int before = model::cells[p.coord(0).cell()]->id_;
+            std::string expression;
+            for (auto c : geometry.child("geometry").children("cell"))
+              if (c.attribute("id").as_int() == before) expression = c.attribute("region").value();
+            Region duplicate("(" + expression + ") | (" + expression + ")", before);
+            const auto original = model::cells[p.coord(0).cell()]->distance(p.r(), p.u(), p.surface(), &p);
+            const auto complex = duplicate.distance(p.r(), p.u(), p.surface());
+#ifdef OPENMC_EXPERIMENTAL_AXIS_PLANES
+            if (settings::experimental_axis_plane_events && original != complex)
+              throw std::runtime_error("R_UNION_R_DIFFERS");
+#endif
+            p.event_calculate_xs();
+            p.event_advance();
+#ifdef OPENMC_EXPERIMENTAL_AXIS_PLANES
+            const auto& ctx = p.axis_plane_context();
+            const bool context_valid = ctx.valid;
+            const auto contacts = ctx.contacts;
+            const int active_axis = ctx.valid ? ctx.axis :
+              (p.u().x != 0. ? 0 : (p.u().y != 0. ? 1 : 2));
+#else
+            const bool context_valid = false;
+            const vector<int> contacts;
+            const int active_axis = p.u().x != 0. ? 0 : (p.u().y != 0. ? 1 : 2);
+#endif
+            if (!first) std::cout << ',';
+            first = false;
+            const int s = p.boundary().surface();
+            std::cout << "{\"before\":" << before << ",\"length\":" << p.boundary().distance()
+              << ",\"region_length\":" << original.first << ",\"surface\":"
+              << (s > 0 ? 1 : -1) * model::surfaces[std::abs(s)-1]->id_
+              << ",\"context\":" << (context_valid ? "true" : "false")
+              << ",\"coordinate\":" << p.r()[active_axis]
+              << ",\"contacts\":[";
+            for (size_t i = 0; i < contacts.size(); ++i) {
+              if (i) std::cout << ',';
+              std::cout << model::surfaces[contacts[i]]->id_;
+            }
+            std::cout << ']';
+            p.event_cross_surface();
+            std::cout << ",\"after\":" << (p.wgt() > 0. ? model::cells[p.coord(0).cell()]->id_ : -1)
+              << ",\"weight\":" << p.wgt();
+            bins();
+            std::cout << '}';
+          }
+        } catch (const std::exception& e) { error = e.what(); }
+        query_state.restore();
+        const bool restored = query_state.matches() && baseline.matches();
+        std::cout << "],\"error\":" << std::quoted(error);
+        std::cout << ",\"fixture_restored\":" << (restored ? "true" : "false")
+          << ",\"source_reset\":" << (source_reset ? "true" : "false")
+          << ",\"source_position_unchanged\":" <<
+            (p.r().x == source.r.x && p.r().y == source.r.y && p.r().z == source.r.z ? "true" : "false");
+        bins();
+        std::cout << "}\n";
+        if (!restored) return 9;
+        if (!error.empty() && !first) return 5; // partial event output is terminal failure
+      }
+    } // Restore/checkpoint objects die while the model is still initialized.
+    code = openmc_finalize();
+    if (code) return code;
+#ifdef OPENMC_EXPERIMENTAL_AXIS_PLANES
+    if (settings::experimental_axis_plane_events) return 10;
+#endif
+  }
+  return 0;
+}
diff --git a/include/openmc/axis_plane_context.h b/include/openmc/axis_plane_context.h
new file mode 100644
index 000000000..d7e158e38
--- /dev/null
+++ b/include/openmc/axis_plane_context.h
@@ -0,0 +1,38 @@
+#ifndef OPENMC_AXIS_PLANE_CONTEXT_H
+#define OPENMC_AXIS_PLANE_CONTEXT_H
+
+#include <array>
+#include <cstdint>
+#include "openmc/vector.h"
+#include "stellarcsg/dyadic_axis_plane.hpp"
+
+namespace openmc {
+struct AxisPlaneContext {
+  uint64_t epoch {0};
+  bool valid {false};
+  bool pending {false};
+  bool advanced {false};
+  std::array<double, 3> anchor {};
+  int axis {0};
+  int direction {1};
+  double coordinate {0.0}; // committed/consumed coordinate in this epoch
+  double event_coordinate {0.0};
+  stellarcsg::DyadicDifference parameter {}; // exact anchor -> pending event
+  vector<int> contacts; // unsigned native indices, deduplicated, ID sorted
+  vector<int> outgoing_sides; // complete strict sides at pending event
+  int owner {-1};
+  int successor {-1};
+  int vacuum_surface {-1};
+  int representative {0};
+  double length {0.0};
+
+  void reset()
+  {
+    ++epoch;
+    valid = pending = advanced = false;
+    contacts.clear();
+    outgoing_sides.clear();
+  }
+};
+} // namespace openmc
+#endif
diff --git a/include/openmc/axis_plane_events.h b/include/openmc/axis_plane_events.h
new file mode 100644
index 000000000..2ad1fcce7
--- /dev/null
+++ b/include/openmc/axis_plane_events.h
@@ -0,0 +1,20 @@
+#ifndef OPENMC_AXIS_PLANE_EVENTS_H
+#define OPENMC_AXIS_PLANE_EVENTS_H
+
+#include "openmc/particle_data.h"
+
+namespace openmc {
+class Region;
+class Particle;
+
+// Experimental, deliberately narrow native event path. Throws std::runtime_error
+// on unsupported input; never falls back to tolerance-based navigation.
+bool axis_plane_find_cell(GeometryState& p);
+BoundaryInfo axis_plane_boundary(GeometryState& p);
+std::pair<double, int32_t> axis_plane_region_distance(
+  const Region& region, Position r, Direction u);
